#include <stdio.h>

void findSubsets(int index, int currentSum, int size)
{
    if (currentSum == target)
    {
        resultSize[count] = size;

        for (int i = 0; i < size; i++)
        {
            result[count][i] = subset[i];
        }

        count++;
        return;
    }

    if (index == n || currentSum > target)
        return;


    subset[size] = a[index];
    findSubsets(index + 1, currentSum + a[index], size + 1);


    findSubsets(index + 1, currentSum, size);
}

int main()
{
    scanf("%d", &n);

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    scanf("%d", &target);

    findSubsets(0, 0, 0);

    if (count == 0)
    {
        printf("-1\n");
    }
    else
    {

        for (int i = count - 1; i >= 0; i--)
        {
            for (int j = 0; j < resultSize[i]; j++)
            {
                printf("%d ", result[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
